    "check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "katex": "0.19.1",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
