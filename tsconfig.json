{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types/latest", "node", "vite/client"]
  },
  "include": ["worker/**/*.ts", "db/**/*.ts", "cloudflare-env.d.ts", "*.config.ts"]
}
